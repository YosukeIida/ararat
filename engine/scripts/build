#!/usr/bin/env bash
set -euo pipefail
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/env.sh"

usage() {
  cat <<'USAGE'
usage: build [--dev]

Runs the read-only series check; when it fails, build stops and says to run
apply without touching the tree (it never resets or re-applies anything).
Then it refuses when the args.gn's ararat_engine_version stamp is older than
the current tree, saying to run gen. Otherwise it takes the engine lock, runs
autoninja -C out/Ararat chrome with its local jobs capped at 95 % of the
CPUs, prints the elapsed time and step count, and appends a one-line JSON
record to $ARARAT_BUILD_ROOT/build-times.jsonl. --dev builds out/Dev instead,
the daily-work directory gen --dev writes.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") out_name="Ararat"; target_rec="chrome" ;;
  --dev) out_name="Dev"; target_rec="chrome (out/Dev)" ;;
  *) die "unknown argument: $1" ;;
esac

"$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/series-check"

[[ -d "$ARARAT_SRC_DIR/out/$out_name" ]] || die "gen has not run: no $ARARAT_SRC_DIR/out/$out_name"

# The stamp is fixed at gen time: an apply after gen changes the tree without
# moving the args, so the build would carry a stale version. Refusing here is
# the same pattern series-check follows.
stamp="$(awk -F'"' '/^ararat_engine_version=/{print $2; exit}' "$ARARAT_SRC_DIR/out/$out_name/args.gn" 2>/dev/null || true)"
want="$(engine_version_value)"
if [[ "$stamp" != "$want" ]]; then
  die "ararat_engine_version in out/$out_name/args.gn does not match the tree: run gen"
fi

lock_take

t0="$(date +%s)"
log="$ARARAT_BUILD_ROOT/last-build.log"
mkdir -p "$ARARAT_BUILD_ROOT"
# background plus a polling wait: the trap set for INT/TERM only executes at
# the next command boundary, so a foreground child holds the lock past its own
# kill; a plain `wait` can do the same; and -m gives its own process group to
# the job, so a TERM reaches autoninja's own children, which a TERM to the
# wrapper alone would leave building
# -local_jobs, not -j: siso refuses -j
jobs=$(( $(sysctl -n hw.ncpu) * 95 / 100 ))
set -m
autoninja -C "$ARARAT_SRC_DIR/out/$out_name" chrome -local_jobs "$jobs" >"$log" 2>&1 &
child=$!
set +m
_signal_child="$child"
rc=0
while kill -0 "$child" 2>/dev/null; do
  sleep 0.5
done
wait "$child" || rc=$?
_signal_child=
t1="$(date +%s)"
if [[ $rc -ne 0 ]]; then
  tail -n 20 "$log" | sed 's/^/        /'
  die "autoninja failed (exit $rc); log at $log"
fi

if [[ $out_name == Ararat ]]; then
  framework="$ARARAT_SRC_DIR/out/$out_name/obj/chrome/chrome_framework_shared_library/Chromium Framework"
  if ! /usr/bin/nm -a "$framework" | /usr/bin/awk '
    $NF == "_AraratMain" { browser_entry = 1 }
    /Ararat.*TouchID|g_ararat_touch_id_authenticator|ScopedTouchIdTestEnvironment|FakeTouchIdContext|check.*TouchID/ {
      print
      found = 1
    }
    END { exit (!browser_entry || found) }
  '; then
    die "could not verify that Touch ID check symbols are absent from the unstripped release framework"
  fi
fi

step_line="$(grep -oE '^\[[0-9,]+(/[0-9,]+)?\]' "$log" | tail -n1 || true)"
steps="${step_line#[}"
steps="${steps%%[,/]*}"
steps="$(printf '%s' "$steps" | tr -d ',')"
printf '{"ts":%s,"target":"%s","steps":%s,"elapsed_sec":%s}\n' \
  "$(date +%s)" "$target_rec" "${steps:-null}" "$((t1 - t0))" >>"$ARARAT_BUILD_ROOT/build-times.jsonl"
msg "build: chrome ${steps:-?} steps in $((t1 - t0))s (recorded in $ARARAT_BUILD_ROOT/build-times.jsonl)"
