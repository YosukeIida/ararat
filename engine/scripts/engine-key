#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
unset DEVELOPER_DIR SDKROOT

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
tree="$(git -C "$repo" rev-parse HEAD:engine)"
manifest="$(git -C "$repo" show "$tree:build-inputs.toml" | shasum -a 256 | cut -d ' ' -f 1)"
key="$(printf '%s\n' "$manifest" "$tree" | shasum -a 256 | cut -d ' ' -f 1)"
printf 'engine-%s\n' "$key"
