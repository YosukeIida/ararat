 namespace history {
 
+// ararat (U27p): the app's Privacy pane sets the browsing-history retention, in days. 0 makes
+// every expiry pass a no-op (the pane's Forever, and the state before the first window applies the
+// record); a positive value replaces Chromium's own threshold. The expiry loop reads it on every
+// pass, so a shortened retention deletes the older visits at a later pass (30 s in the first
+// minute, then five minutes) without a relaunch.
+extern std::atomic<int> g_ararat_history_retention_days;
