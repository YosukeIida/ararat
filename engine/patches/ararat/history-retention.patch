 namespace history {
 
+// ararat (U27p): the app's Privacy pane sets the browsing-history retention. The value is in
+// days; -1 keeps Chromium's own threshold (HistoryBackend::kExpireDaysThreshold), 0 never
+// expires anything (the pane's Forever), and a positive value replaces the threshold. The
+// expiry loop reads it on every pass, so a shortened retention deletes older visits without a
+// relaunch.
+extern std::atomic<int> g_ararat_history_retention_days;
+
 class HistoryBackendClient;
 class HistoryBackendNotifier;
 class HistoryDatabase;
@@ -119,6 +127,14 @@
   // Note that this as an absolute time rather than a delta, so the caller
   // should not save it.
   base::Time GetCurrentExpirationTime() const {
+    const int ararat_days =
+        g_ararat_history_retention_days.load(std::memory_order_relaxed);
+    if (ararat_days == 0) {
+      return base::Time();
+    }
+    if (ararat_days > 0) {
+      return base::Time::Now() - base::Days(ararat_days);
+    }
     return base::Time::Now() - expiration_threshold_;
   }
 
