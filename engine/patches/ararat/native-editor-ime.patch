--- a/chrome/browser/chrome_browser_application_mac.mm
+++ b/chrome/browser/chrome_browser_application_mac.mm
@@ -365,6 +365,24 @@
     BOOL sendEventToKeyWindow = NO;
     if (event.type == NSEventTypeKeyDown &&
         (event.keyCode == kVK_JIS_Eisu || event.keyCode == kVK_JIS_Kana)) {
+      NSResponder* responder = NSApp.keyWindow.firstResponder;
+      // Why not import the view: its Cocoa implementation is private to content.
+      if (![responder
+              isKindOfClass:NSClassFromString(@"RenderWidgetHostViewCocoa")]) {
+        TISInputSourceRef source = TISCopyCurrentKeyboardInputSource();
+        bool is_input_method =
+            source &&
+            CFEqual(TISGetInputSourceProperty(source,
+                                              kTISPropertyInputSourceType),
+                    kTISTypeKeyboardInputMode);
+        if (source)
+          CFRelease(source);
+        if (is_input_method && [responder isKindOfClass:[NSView class]])
+          [[(NSView*)responder inputContext] handleEvent:event];
+        // Why not offer layout keys: a US-only input context can insert C0.
+        return;
+      }
+
       // Mac Eisu and Kana keydown events are by default swallowed by sendEvent
       // and sent directly to IME, which prevents ui keydown events from firing.
       // These events need to be sent to [NSApp keyWindow] for handling.
