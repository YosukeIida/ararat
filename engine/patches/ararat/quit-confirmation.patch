+bool MaybeDeferAraratQuit(bool system_quit, void (^continuation)(void)) {
+  if (!g_ararat_quit_confirmation || browser_shutdown::IsTryingToQuit())
+    return false;
+  NSEvent* event = NSApp.currentEvent;
+  bool shortcut = event.type == NSEventTypeKeyDown &&
+                  CommandForKeyEvent(event).chrome_command == IDC_EXIT;
+  return g_ararat_quit_confirmation(system_quit, shortcut,
+                                   shortcut && event.isARepeat, continuation);
+}
 
