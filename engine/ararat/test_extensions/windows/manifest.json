{
  "manifest_version": 3,
  "name": "Ararat windows check with a wide extension menu entry for floating sidebar selection",
  "version": "1.0",
  "permissions": ["tabs", "storage"],
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"]}],
  "background": {"service_worker": "background.js"},
  "commands": {
    "probe-command": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Record shortcut execution"},
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+I"}}
  },
  "action": {"default_popup": "popup.html"},
  "key": ""
}
