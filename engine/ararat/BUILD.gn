# Our in-tree layer. engine/scripts/apply copies this directory to
# //ararat/core. Three targets:
#   hooks  the hook declarations Chrome's patched files include
#   core   the version stamp
#   entry  the browser process's entry point and the extra parts the hook adds
# The exports config rides all_dependent_configs so the target that links the
# layer's objects (chrome_dll, see patches/ararat/link-ararat-layer.patch)
# exports our symbols on the same link line as chrome's framework.exports.

declare_args() {
  # Written by engine/scripts/gen; empty means gen has not run for this tree.
  ararat_engine_version = ""
}

config("ararat_exports") {
  ldflags = [
    "-Wl,-exported_symbols_list",
    "-Wl," + rebase_path("ararat.exports", root_build_dir),
  ]
  inputs = [ "ararat.exports" ]
}

source_set("hooks") {
  sources = [ "ararat_hooks.h" ]
  public = [ "ararat_hooks.h" ]
}

source_set("core") {
  sources = [ "ararat_version.cc" ]
  deps = [ "//base" ]
  defines = [ "ARARAT_ENGINE_VERSION=\"$ararat_engine_version\"" ]
  all_dependent_configs = [ ":ararat_exports" ]
}

source_set("entry") {
  sources = [ "ararat_main.mm", "ararat_browser_window.cc", "ararat_browser_window.h", "ararat_window_host.mm", "ararat_window_host.h", "ararat_window_check.mm", "ararat_window_check.h", "ararat_tabs_check.mm", "ararat_tab.mm", "ararat_tab.h", "ararat_measure.mm" ]
  public = [ "public/AraratEngine.h", "public/AraratHostAPI.h", "public/ARWindowHost.h", "public/ARTab.h" ]
  deps = [
    ":core",
    ":hooks",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:global_features",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/lifetime:lifetime",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles/keep_alive:keep_alive",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui:unload_controller",
    "//chrome/browser/ui/find_bar",
    "//chrome/browser/ui/exclusive_access",
    "//ui/base",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx",
    "//ui/gfx:native_ui_types",
    "//ui/gfx/geometry",
    "//ui/views",
    "//chrome/browser/ui/browser_window:browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/window_metadata",
    "//chrome/common",
    "//chrome/common:constants",
    "//components/input",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//content/public/browser",
    "//content/public/common",
    "//url",
  ]
}
