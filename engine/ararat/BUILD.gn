# Our in-tree layer. engine/scripts/apply copies this directory to
# //ararat/core. Three targets:
#   hooks  the hook declarations Chrome's patched files include
#   core   the version stamp
#   entry  the browser process's entry point and the extra parts the hook adds
# The exports config rides all_dependent_configs so the target that links the
# layer's objects (chrome_dll, see patches/ararat/link-ararat-layer.patch)
# exports our symbols on the same link line as chrome's framework.exports.

import("//testing/test.gni")

declare_args() {
  # Written by engine/scripts/gen; empty means gen has not run for this tree.
  ararat_engine_version = ""
}

config("ararat_exports") {
  ldflags = [
    "-Wl,-exported_symbols_list",
    "-Wl," + rebase_path("ararat.exports", root_build_dir),
  ]
  inputs = [ "ararat.exports" ]
}

source_set("hooks") {
  sources = [ "ararat_hooks.h" ]
  public = [ "ararat_hooks.h" ]
  public_deps = [ "//components/permissions" ]
}

source_set("core") {
  sources = [ "ararat_version.cc" ]
  deps = [ "//base" ]
  defines = [ "ARARAT_ENGINE_VERSION=\"$ararat_engine_version\"" ]
  all_dependent_configs = [ ":ararat_exports" ]
}

source_set("history_files") {
  sources = [ "ararat_history_files.cc", "ararat_history_files.h", "ararat_history_sequence.cc", "ararat_history_sequence.h" ]
  deps = [ "//base" ]
  public_deps = [ "//components/sessions" ]
}

test("history_files_unittests") {
  sources = [ "ararat_history_files_unittest.cc" ]
  deps = [
    ":history_files",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

source_set("entry") {
  sources = [ "ararat_downloads.h", "ararat_downloads.mm", "ararat_autofill_bubble_handler.cc", "ararat_autofill_bubble_handler.h", "ararat_extensions_container.cc", "ararat_extensions_container.h", "ararat_permission_prompt.cc", "ararat_permission_prompt.h", "ararat_main.mm", "ararat_browser_window.cc", "ararat_browser_window.h", "ararat_window_host.mm", "ararat_window_host.h", "ararat_window_check.mm", "ararat_window_check.h", "ararat_tabs_check.mm", "ararat_tab.mm", "ararat_tab.h", "ararat_tab_history.mm", "ararat_tab_history.h", "ararat_measure.mm" ]
